   "source": [
    "One-hot encoding: turn category labels into a bank of 0/1 switches, so the model can weight each category individually.\n",
    "QuantileTransformer: reshape skewed numeric columns into a well-behaved, comparable scale, so no single numeric feature distorts the fit just because of its raw magnitude."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 34,
   "id": "cde99c82",
   "metadata": {},
   "outputs": [],
   "source": [
    "enc = OneHotEncoder(categories='auto', sparse_output=False)\n",
    "features_cat = enc.fit_transform(features_cat_raw)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 35,
   "id": "dda3e9fe",
   "metadata": {},
   "outputs": [],
   "source": [
    "quantile_transformer = QuantileTransformer(output_distribution='normal')\n",
    "features_cont = quantile_transformer.fit_transform(features_cont_raw)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 38,
   "id": "1a911b55",
